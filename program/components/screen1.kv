<Screen1@MDScreen>:
    name: "Прямые измерения"

    BoxLayoutPresetWithGuide:

        MDTextField:
            id: id_pz_0

            MDTextFieldHintText:
                text: "Данные"

        MDTextField:
            id: id_pz_1

            MDTextFieldHintText:
                text: "Точность прибора"

        MDTextField:
            id: id_pz_2
            multiline: True
            mode: "filled"

            MDTextFieldHelperText:
                mode: "persistent"
                text: "Результат"

        MDButton:
            pos_hint: {"center_x": 0.5}
            on_release: app.calc1((id_pz_0.text, id_pz_1.text), id_pz_2)

            MDButtonText:
                text: "calc"

        MDWidget:
