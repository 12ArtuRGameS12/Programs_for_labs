<ScreenGuide@MDScreen>:
    name: "guide screen"
    text: ""

    BoxLayoutPreset:
        text: root.text

        MDLabel:
            text_size: None, None
            text_size: self.size
            valign: "center"
            halign: "center"

            text: open("program/text/{}.txt".format(root.text), encoding="utf-8").read() if root.text else ""
